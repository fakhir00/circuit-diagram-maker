---
import { getLocalizedPath, useTranslations, locales } from '../theme/i18n';

interface Props {
  locale: string;
  config: any;
}

const { locale, config } = Astro.props;
const t = useTranslations(locale);
const rawPath = Astro.url.pathname;
const currentPath = rawPath === '/404' || rawPath === '/404.html' || rawPath.endsWith('/404') || rawPath.endsWith('/404.html') ? '/' : rawPath;
---

<header class="bg-bg-panel border-b border-white/5 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      
      <!-- Brand -->
      <div class="flex-shrink-0 flex items-center gap-2">
        <a href={getLocalizedPath('/', locale)} class="flex items-center gap-3 group" aria-label="Home">
          <div class="relative flex items-center justify-center">
            <svg class="w-9 h-9 transform transition-all duration-500 group-hover:rotate-12 group-hover:scale-110" viewBox="0 0 40 40" fill="none">
              <defs>
                <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:var(--color-brand-primary);stop-opacity:1" />
                  <stop offset="100%" style="stop-color:var(--color-brand-secondary);stop-opacity:1" />
                </linearGradient>
                <filter id="logoGlow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="2" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
              </defs>
              <!-- Outer hexagon-ish frame -->
              <path d="M20,2 L36,11 L36,29 L20,38 L4,29 L4,11 Z" 
                    fill="none" stroke="url(#logoGrad)" stroke-width="2.5" stroke-linejoin="round"
                    class="opacity-40 group-hover:opacity-100 transition-opacity" />
              <!-- Schematic Node -->
              <circle cx="20" cy="20" r="5" fill="url(#logoGrad)" filter="url(#logoGlow)" />
              <!-- Connecting Traces -->
              <path d="M10,14 L20,20 L30,14 M20,20 L20,32" 
                    stroke="url(#logoGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="absolute inset-0 bg-brand-primary/20 blur-xl rounded-full scale-0 group-hover:scale-100 transition-transform duration-700 opacity-30"></div>
          </div>
          <div class="flex flex-col leading-none">
            <span class="font-black text-lg sm:text-xl tracking-tight text-white group-hover:text-brand-primary transition-colors uppercase">
              {t('brand.name').split(' ').map((word: string, i: number) => (
                <span class={i === 1 ? 'text-slate-500' : i === 2 ? 'ml-1 text-slate-600' : ''}>{word}</span>
              ))}
            </span>
            <span class="text-[8px] sm:text-[9px] font-bold text-brand-secondary tracking-[0.15em] sm:tracking-[0.2em] uppercase opacity-70 truncate">{t('brand.tagline')}</span>
          </div>
        </a>
      </div>

      <!-- JSON-LD SiteNavigationElement -->
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ItemList",
        "itemListElement": config.nav
          .filter((item: any) => item.path && item.path !== '#')
          .map((item: any, index: number) => ({
            "@type": "SiteNavigationElement",
            "position": index + 1,
            "name": t(item.labelKey),
            "url": new URL(getLocalizedPath(item.path, locale), config.site.url)
          }))
      })} />

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center space-x-6">
        {config.nav.map((item: any) => {
           const hasChildren = item.children && item.children.length > 0;
           const isActive = currentPath === getLocalizedPath(item.path, locale);
           
           if (hasChildren) {
             return (
               <div class="relative group">
                 <button class="flex items-center gap-1 text-sm font-medium text-slate-300 hover:text-white transition-colors py-2">
                   {t(item.labelKey)}
                   <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                 </button>
                 <div class="absolute left-0 mt-1 w-56 bg-bg-panel border border-white/10 rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all p-2 z-50 backdrop-blur-3xl">
                   <div class="absolute inset-0 bg-brand-primary/5 rounded-xl pointer-events-none"></div>
                   {item.children.map((child: any) => (
                     <a 
                       href={getLocalizedPath(child.path, locale)} 
                       class="relative block px-3 py-2 text-xs font-semibold text-slate-300 hover:text-brand-accent hover:bg-white/5 rounded-lg transition-colors"
                     >
                       {t(child.labelKey)}
                     </a>
                   ))}
                 </div>
               </div>
             );
           }

           return (
             <a 
               href={getLocalizedPath(item.path, locale)} 
               class={`text-sm font-medium transition-colors ${isActive ? 'text-brand-accent' : 'text-slate-300 hover:text-white'}`}
             >
               {t(item.labelKey)}
             </a>
           );
        })}
      </nav>

      <!-- Language Switcher & Mobile Menu Toggle -->
      <div class="flex items-center gap-2 sm:gap-4">
        
        <div class="relative group" id="lang-dropdown-wrapper">
          <button 
            type="button"
            id="lang-menu-btn"
            class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-semibold text-slate-300 hover:text-white uppercase transition-colors rounded-lg border border-white/10 hover:border-white/20 bg-bg-surface/50"
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="Select language"
          >
            <span>{locale.toUpperCase()}</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div 
            id="lang-menu-dropdown"
            class="absolute right-0 mt-2 w-56 max-h-80 overflow-y-auto bg-bg-surface border border-white/15 rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all p-1.5 z-50 divide-y divide-white/5 scrollbar-thin scrollbar-thumb-white/10"
          >
            <div class="px-2 py-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Select Language</div>
            <div class="grid grid-cols-1 gap-0.5 pt-1">
              {locales.map((l) => (
                <a 
                  href={getLocalizedPath(currentPath, l)} 
                  class={`px-2.5 py-1.5 text-xs font-medium rounded-lg transition-colors flex items-center justify-between ${locale === l ? 'bg-brand-primary/20 text-brand-primary font-bold' : 'text-slate-300 hover:bg-white/10 hover:text-white'}`}
                >
                  <span class="truncate">{l.toUpperCase()} – {l === 'en' ? 'English' : l === 'es' ? 'Español' : l === 'id' ? 'Bahasa Indonesia' : l === 'tr' ? 'Türkçe' : l === 'bg' ? 'Български' : l === 'de' ? 'Deutsch' : l === 'fr' ? 'Français' : l === 'it' ? 'Italiano' : l === 'pt' ? 'Português' : l === 'ru' ? 'Русский' : l === 'hi' ? 'हिन्दी' : l === 'ja' ? '日本語' : l === 'ko' ? '한국어' : l === 'zh' ? '中文' : l === 'ar' ? 'العربية' : l === 'bn' ? 'বাংলা' : l === 'ms' ? 'Melayu' : l === 'pl' ? 'Polski' : l === 'sv' ? 'Svenska' : l.toUpperCase()}</span>
                  {locale === l && <span class="w-1.5 h-1.5 rounded-full bg-brand-primary flex-shrink-0 ml-1.5"></span>}
                </a>
              ))}
            </div>
          </div>
        </div>

        <button id="mobile-menu-btn" class="md:hidden text-slate-300 hover:text-white" aria-expanded="false" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path id="menu-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-bg-surface border-t border-white/5" aria-hidden="true">
    <div class="px-2 pt-2 pb-3 space-y-1 max-h-[85vh] overflow-y-auto">
      {config.nav.map((item: any) => {
         const hasChildren = item.children && item.children.length > 0;
         
         if (hasChildren) {
           return (
             <div class="pt-2 pb-1">
               <div class="px-3 py-2 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">{t(item.labelKey)}</div>
               {item.children.map((child: any) => (
                 <a 
                   href={getLocalizedPath(child.path, locale)} 
                   class="block px-6 py-2 rounded-md text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
                 >
                   {t(child.labelKey)}
                 </a>
               ))}
             </div>
           );
         }

         return (
           <a 
             href={getLocalizedPath(item.path, locale)} 
             class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition-colors"
           >
             {t(item.labelKey)}
           </a>
         );
      })}

      <!-- Mobile Language Switcher -->
      <div class="pt-4 pb-2 border-t border-white/10 px-3">
        <div class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 mb-2">Switch Language</div>
        <div class="grid grid-cols-3 gap-1.5">
          {locales.map((l) => (
            <a 
              href={getLocalizedPath(currentPath, l)} 
              class={`px-2 py-1.5 text-xs rounded-lg text-center transition-colors font-medium ${locale === l ? 'bg-brand-primary text-white font-bold' : 'bg-white/5 text-slate-300 hover:bg-white/10 hover:text-white'}`}
            >
              {l.toUpperCase()}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon-path');

  if (btn && menu && icon) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
      menu.setAttribute('aria-hidden', String(expanded));
      if (!expanded) {
        icon.setAttribute('d', 'M6 18L18 6M6 6l12 12'); // X icon
        document.body.style.overflow = 'hidden';
      } else {
        icon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16'); // Hamburger
        document.body.style.overflow = '';
      }
    });

    // Close when clicking a link
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        icon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
        document.body.style.overflow = '';
      });
    });
  }

  const langBtn = document.getElementById('lang-menu-btn');
  const langDropdown = document.getElementById('lang-menu-dropdown');
  if (langBtn && langDropdown) {
    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isVisible = langDropdown.classList.contains('opacity-100');
      if (isVisible) {
        langDropdown.classList.remove('opacity-100', 'visible');
        langDropdown.classList.add('opacity-0', 'invisible');
        langBtn.setAttribute('aria-expanded', 'false');
      } else {
        langDropdown.classList.remove('opacity-0', 'invisible');
        langDropdown.classList.add('opacity-100', 'visible');
        langBtn.setAttribute('aria-expanded', 'true');
      }
    });

    document.addEventListener('click', (e) => {
      if (!langDropdown.contains(e.target as Node) && !langBtn.contains(e.target as Node)) {
        langDropdown.classList.remove('opacity-100', 'visible');
        langDropdown.classList.add('opacity-0', 'invisible');
        langBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
