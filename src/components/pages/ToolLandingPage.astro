---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InteractiveToolPreview from '../InteractiveToolPreview.astro';
import { toolLandingData } from '../../data/toolLandingContent';

interface Props {
  locale: string;
  title: string;
  description: string;
  eyebrow: string;
  heroTitle: string;
  heroDescription: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
  featureTitle: string;
  featureIntro: string;
  features: { title: string; desc: string }[];
  useCases: string[];
  tableTitle: string;
  tableHeaders: string[];
  tableRows: string[][];
  presetId?: string;
  homeLinkAnchor?: string;
  homeLinkHref?: string;
  t: (key: string) => string;
}

const {
  title,
  locale,
  description,
  eyebrow,
  heroTitle,
  heroDescription,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  featureTitle,
  featureIntro,
  features,
  useCases,
  tableTitle,
  tableHeaders,
  tableRows,
  presetId,
  homeLinkAnchor,
  homeLinkHref,
  t
} = Astro.props;

const richData = presetId ? toolLandingData[presetId] : undefined;
const targetHomeHref = homeLinkHref || (locale === 'en' ? '/' : `/${locale}/`);
const targetHomeAnchor = homeLinkAnchor || (locale !== 'en' ? t('nav.brand.default') : undefined);
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-bg-dark pt-20 pb-14 sm:pt-24 sm:pb-16">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(59,130,246,0.12),transparent_35%),radial-gradient(circle_at_bottom_right,rgba(34,211,238,0.08),transparent_28%)]"></div>
    <div class="relative mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
      <p class="mx-auto max-w-full break-words text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-accent sm:text-sm sm:tracking-[0.35em]">{eyebrow}</p>
      <h1 class="mx-auto mt-5 max-w-4xl break-words text-2xl font-black leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl text-balance">
        {heroTitle}
      </h1>
      <p class="mx-auto mt-5 max-w-3xl break-words text-base leading-7 text-slate-400 sm:mt-6 sm:text-xl sm:leading-8">
        {heroDescription}
      </p>
      <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:mt-10 sm:flex-row sm:items-center">
        <a href={primaryCtaHref} class="w-full rounded-xl bg-brand-primary px-6 py-3.5 text-center text-sm font-semibold text-white transition hover:bg-blue-500 shadow-[0_0_24px_rgba(59,130,246,0.18)] sm:w-auto sm:px-8">
          {primaryCtaLabel}
        </a>
        <a href={secondaryCtaHref} class="w-full rounded-xl border border-white/10 px-6 py-3.5 text-center text-sm font-medium text-white transition hover:border-white/20 hover:bg-white/5 sm:w-auto sm:px-8">
          {secondaryCtaLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Canvas Preview -->
  {presetId && (
    <section class="bg-bg-dark border-y border-white/5 py-12">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <InteractiveToolPreview presetId={presetId} locale={locale} ctaHref={primaryCtaHref} ctaLabel={primaryCtaLabel} />
      </div>
    </section>
  )}

  <!-- In-Depth Technical Architecture & Overview -->
  {richData && (
    <section class="border-t border-white/5 bg-bg-panel py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-accent">Technical Architecture</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">{richData.inDepthGuide.title}</h2>
          <p class="mt-4 text-base leading-7 text-slate-400 sm:text-lg">{richData.inDepthGuide.subtitle}</p>
        </div>

        <div class="mt-10 grid gap-8 lg:grid-cols-3">
          <div class="lg:col-span-2 space-y-6 text-slate-300 leading-relaxed text-base">
            {richData.inDepthGuide.paragraphs.map((p) => (
              <p class="rounded-xl border border-white/5 bg-bg-surface/40 p-5 sm:p-6">{p}</p>
            ))}
          </div>

          <div class="space-y-4">
            <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Engineering Capabilities</h3>
            {richData.inDepthGuide.keyHighlights.map((highlight) => (
              <div class="rounded-2xl border border-white/10 bg-bg-surface/70 p-5 transition-all hover:border-brand-primary/30">
                <h4 class="font-bold text-white text-sm">{highlight.label}</h4>
                <p class="mt-2 text-xs text-slate-400 leading-relaxed">{highlight.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Core Features Grid -->
  <section class="bg-bg-dark border-t border-white/5 py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="break-words text-2xl font-bold tracking-tight text-white sm:text-4xl">{featureTitle}</h2>
        <p class="mt-4 break-words text-base leading-7 text-slate-400 sm:text-lg sm:leading-8">{featureIntro}{targetHomeAnchor && <Fragment> This tool is part of our <a href={targetHomeHref} class="text-brand-primary hover:text-blue-400 underline underline-offset-4 decoration-1 transition-colors">{targetHomeAnchor}</a> suite.</Fragment>}</p>
      </div>

      <div class="mt-8 grid gap-4 sm:mt-10 sm:gap-6 md:grid-cols-2 lg:grid-cols-3">
        {features.map((feature) => (
          <article class="rounded-2xl border border-white/10 bg-bg-surface/70 p-5 transition-colors hover:border-brand-primary/25 hover:bg-bg-surface sm:p-6">
            <h3 class="break-words text-base font-semibold text-white sm:text-lg">{feature.title}</h3>
            <p class="mt-3 break-words text-sm leading-6 text-slate-400 sm:leading-7">{feature.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Step-by-Step How-To Guide -->
  {richData && (
    <section class="border-t border-white/5 bg-bg-panel py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-accent">Workflow Guide</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">{richData.howToGuide.title}</h2>
          <p class="mt-4 text-base leading-7 text-slate-400 sm:text-lg">{richData.howToGuide.subtitle}</p>
        </div>

        <div class="mt-12 space-y-6">
          {richData.howToGuide.steps.map((item) => (
            <div class="rounded-2xl border border-white/10 bg-bg-surface/60 p-6 transition-all hover:border-brand-primary/30 sm:p-8">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-primary/10 border border-brand-primary/25 font-mono text-lg font-black text-brand-accent">
                  {item.stepNum}
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg font-bold text-white sm:text-xl">{item.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">{item.instructions}</p>
                  <div class="mt-4 rounded-xl border border-amber-400/20 bg-amber-400/5 px-4 py-3 text-xs leading-relaxed text-amber-300/90">
                    <strong class="font-bold uppercase tracking-wider text-amber-200">Engineering Pro-Tip: </strong>
                    {item.proTip}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Concrete Worked Example -->
  {richData && (
    <section class="border-t border-white/5 bg-bg-dark py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-accent">Practical Application</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">{richData.workedExample.title}</h2>
          <p class="mt-4 text-base leading-7 text-slate-400 sm:text-lg">{richData.workedExample.subtitle}</p>
        </div>

        <div class="mt-10 rounded-2xl border border-white/10 bg-bg-surface/60 p-6 sm:p-8">
          <div class="mb-6 border-b border-white/10 pb-6">
            <span class="inline-block rounded-md bg-brand-primary/10 border border-brand-primary/20 px-3 py-1 text-xs font-mono font-bold text-brand-accent">Circuit Blueprint</span>
            <h3 class="mt-2 text-xl font-bold text-white sm:text-2xl">{richData.workedExample.circuitName}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">{richData.workedExample.problemStatement}</p>
          </div>

          <!-- Bill of Materials Table -->
          <div class="my-8">
            <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400 mb-4">Bill of Materials (BOM) & Electrical Ratings</h4>
            <div class="overflow-x-auto rounded-xl border border-white/10 bg-bg-panel">
              <table class="w-full text-left text-xs sm:text-sm">
                <thead class="bg-white/5 text-slate-300">
                  <tr>
                    <th class="px-4 py-3 font-semibold uppercase tracking-wider">Ref</th>
                    <th class="px-4 py-3 font-semibold uppercase tracking-wider">Component</th>
                    <th class="px-4 py-3 font-semibold uppercase tracking-wider">Electrical Specification</th>
                    <th class="px-4 py-3 font-semibold uppercase tracking-wider">Functional Role</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/10 text-slate-300">
                  {richData.workedExample.bom.map((item) => (
                    <tr class="hover:bg-white/[0.02]">
                      <td class="px-4 py-3 font-mono font-bold text-brand-accent">{item.ref}</td>
                      <td class="px-4 py-3 font-semibold text-white">{item.name}</td>
                      <td class="px-4 py-3 font-mono text-slate-400">{item.spec}</td>
                      <td class="px-4 py-3 text-slate-300">{item.role}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Wiring Stages -->
          <div class="my-8 space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400 mb-4">Step-by-Step Schematic Wiring Procedure</h4>
            {richData.workedExample.wiringSteps.map((ws) => (
              <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4 sm:p-5">
                <p class="text-xs font-mono font-bold text-brand-accent uppercase">{ws.step}</p>
                <h5 class="mt-1 text-sm font-bold text-white sm:text-base">{ws.title}</h5>
                <p class="mt-2 text-xs leading-relaxed text-slate-400 sm:text-sm">{ws.details}</p>
              </div>
            ))}
          </div>

          <!-- Electrical Validation -->
          <div class="mt-8 rounded-xl border border-emerald-400/20 bg-emerald-400/5 p-5 text-xs sm:text-sm text-slate-300 leading-relaxed">
            <p class="font-bold text-emerald-400 uppercase tracking-wider mb-2">Electrical Analysis & Verification:</p>
            {richData.workedExample.validationNotes}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- When to Use vs Alternatives Comparison -->
  {richData && (
    <section class="border-t border-white/5 bg-bg-panel py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-accent">Tool Comparison</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">{richData.comparisons.title}</h2>
          <p class="mt-4 text-base leading-7 text-slate-400 sm:text-lg">{richData.comparisons.subtitle}</p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {richData.comparisons.competitors.map((comp) => (
            <div class="rounded-2xl border border-white/10 bg-bg-surface/70 p-6 flex flex-col justify-between">
              <div>
                <span class="inline-block rounded-md bg-white/5 border border-white/10 px-2.5 py-1 text-[10px] font-mono uppercase text-slate-400">{comp.type}</span>
                <h3 class="mt-3 text-lg font-bold text-white">{comp.name}</h3>
                <div class="mt-4 space-y-3 text-xs leading-relaxed">
                  <p class="text-slate-300"><strong class="text-emerald-400">Strengths: </strong>{comp.strengths}</p>
                  <p class="text-slate-400"><strong class="text-rose-400">Drawbacks: </strong>{comp.drawbacks}</p>
                </div>
              </div>
              <div class="mt-6 pt-4 border-t border-white/10 text-xs text-brand-accent font-medium leading-relaxed">
                <strong>When to Choose: </strong>{comp.whenToUse}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 rounded-xl border border-white/5 bg-white/[0.02] p-6 text-sm text-slate-300 leading-relaxed">
          {richData.comparisons.summary}
        </div>
      </div>
    </section>
  )}

  <!-- Specifications Table & Use Cases Section -->
  <section class="border-t border-white/5 bg-bg-dark py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.15fr)_340px] lg:gap-12">
        <div class="min-w-0">
          <h2 class="break-words text-2xl font-bold tracking-tight text-white sm:text-3xl">{tableTitle}</h2>

          <div class="mt-6 grid gap-4 md:hidden">
            {tableRows.map((row) => (
              <article class="rounded-2xl border border-white/10 bg-bg-panel p-4">
                <div class="space-y-3">
                  {row.map((cell, index) => (
                    <div class:list={['rounded-xl px-3 py-3', index === 0 ? 'bg-white/[0.04]' : 'border border-white/8 bg-white/[0.02]']}>
                      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-500">{tableHeaders[index]}</p>
                      <p class:list={['mt-1 break-words text-sm leading-6', index === 0 ? 'font-semibold text-white' : 'text-slate-300']}>{cell}</p>
                    </div>
                  ))}
                </div>
              </article>
            ))}
          </div>

          <div class="mt-6 hidden overflow-hidden rounded-2xl border border-white/10 bg-bg-panel md:block md:mt-8">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead class="bg-white/5 text-slate-300">
                  <tr>
                    {tableHeaders.map((header) => (
                      <th class="px-4 py-3 text-xs font-semibold uppercase tracking-[0.16em] md:px-6 md:py-4 md:tracking-[0.22em]">{header}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/10 text-slate-300">
                  {tableRows.map((row) => (
                    <tr class="transition-colors hover:bg-white/5">
                      {row.map((cell, index) => (
                        <td class:list={['px-4 py-3 align-top break-words md:px-6 md:py-4', index === 0 ? 'font-semibold text-white' : 'text-slate-400']}>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <aside class="rounded-2xl border border-white/10 bg-bg-surface/80 p-5 sm:p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-brand-accent">{t('common.best_for')}</p>
          <ul class="mt-5 space-y-3">
            {useCases.map((item) => (
              <li class="rounded-xl border border-white/10 bg-white/[0.03] px-4 py-3 text-sm leading-6 text-slate-300 break-words">{item}</li>
            ))}
          </ul>
          <div class="mt-6 rounded-2xl border border-brand-primary/20 bg-brand-primary/10 p-5 sm:mt-8">
            <h3 class="break-words text-lg font-semibold text-white">{t('common.start_designing')}</h3>
            <p class="mt-2 break-words text-sm leading-7 text-slate-300">
              {t('common.start_designing_desc')}
            </p>
            <a href={primaryCtaHref} class="mt-5 inline-flex w-full items-center justify-center rounded-xl bg-brand-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-500 sm:w-auto">
              {primaryCtaLabel}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Technical FAQs -->
  {richData && (
    <section class="border-t border-white/5 bg-bg-panel py-16 sm:py-24">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-accent">Frequently Asked Questions</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">Engineering & Usage Questions</h2>
          <p class="mt-4 text-base leading-7 text-slate-400">Technical insights, hardware conventions, and design standards.</p>
        </div>

        <div class="mt-12 space-y-4">
          {richData.faqs.map((faq) => (
            <details class="group rounded-2xl border border-white/10 bg-bg-surface/70 p-6 transition-all hover:border-white/20 open:border-brand-primary/40 open:bg-bg-surface">
              <summary class="flex cursor-pointer items-center justify-between font-bold text-white text-base sm:text-lg list-none">
                <span>{faq.question}</span>
                <span class="ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/5 text-slate-400 group-open:rotate-180 group-open:bg-brand-primary/20 group-open:text-brand-accent transition-transform">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                </span>
              </summary>
              <p class="mt-4 text-sm leading-relaxed text-slate-300 sm:text-base border-t border-white/5 pt-4">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
