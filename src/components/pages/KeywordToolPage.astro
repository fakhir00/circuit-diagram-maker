---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../theme/i18n';
import InlineKeywordTool from './InlineKeywordTool.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedToolsSection from '../../components/RelatedToolsSection.astro';
import { toolLandingData } from '../../data/toolLandingContent';

interface Props {
  locale: string;
  heading: string;
  toolKey: 'boolean-expression-simplifier' | 'truth-table-to-logic-circuit';
  homeLinkAnchor?: string;
  homeLinkHref?: string;
}

const { locale, heading, toolKey, homeLinkAnchor, homeLinkHref } = Astro.props;
const t = useTranslations(locale);

const translateText = (key: string, fallback: string) => {
  const value = t(key);
  return typeof value === 'string' && value !== key ? value : fallback;
};

// Tool-specific metadata (SEO)
const toolMeta = {
  'boolean-expression-simplifier': {
    title: translateText('keyword.heading.boolean_expression_simplifier', heading),
    description: translateText('keyword.meta.boolean_expression_simplifier', 'Simplify any boolean algebra expression instantly. Supports SOP notation, De Morgan law reduction, truth table generation and gate diagram output.')
  },
  'truth-table-to-logic-circuit': {
    title: translateText('keyword.heading.truth_table_to_logic_circuit', heading),
    description: translateText('keyword.meta.truth_table_to_logic_circuit', 'Convert truth-table output patterns into simplified Boolean expressions and practical gate-level circuit plans for faster validation.')
  }
};

const heroContent = {
  'boolean-expression-simplifier': {
    eyebrow: translateText('keyword.hero.boolean.eyebrow', 'Boolean Algebra Workspace'),
    title: translateText('keyword.hero.boolean.title', 'Boolean Expression Simplifier: Reduce Any Logic Expression Instantly'),
    description: translateText(
      'keyword.hero.boolean.description',
      'Simplify boolean algebra expressions in seconds. Enter SOP or standard notation, apply De Morgan\u2019s laws, find prime implicants with Quine\u2013McCluskey reduction, and generate the truth table plus gate network automatically.'
    ),
    primaryCtaLabel: translateText('keyword.hero.boolean.cta.primary', 'Simplify an Expression'),
    primaryCtaHref: '#inline-tool',
    secondaryCtaLabel: translateText('keyword.hero.boolean.cta.secondary', 'See How It Works'),
    secondaryCtaHref: '#guide'
  },
  'truth-table-to-logic-circuit': {
    eyebrow: translateText('keyword.hero.truth.eyebrow', 'Digital Logic Converter'),
    title: translateText('keyword.hero.truth.title', 'Truth Table to Logic Circuit: From Output Bits to Gate Design'),
    description: translateText(
      'keyword.hero.truth.description',
      'Convert truth-table output patterns into a simplified boolean expression and a practical gate-level circuit plan. Validate variable and bit lengths, extract minterms, and reduce the result to a minimal implementation.'
    ),
    primaryCtaLabel: translateText('keyword.hero.truth.cta.primary', 'Generate a Circuit'),
    primaryCtaHref: '#inline-tool',
    secondaryCtaLabel: translateText('keyword.hero.truth.cta.secondary', 'See How It Works'),
    secondaryCtaHref: '#guide'
  }
};

const dataKey = toolKey === 'boolean-expression-simplifier' ? 'boolean' : 'truth_table';
const richData = toolLandingData[dataKey];

const resolvedHeading = toolMeta[toolKey].title;
const pageDescription = toolMeta[toolKey].description;
const faqItems = richData ? richData.faqs.map((f) => ({ question: f.question, answer: f.answer, display: true })) : [];

const targetHomeHref = homeLinkHref || (locale === 'en' ? '/' : `/${locale}/`);
const targetHomeAnchor = homeLinkAnchor || (locale !== 'en' ? t('nav.brand.default') : undefined);
---

<BaseLayout title={resolvedHeading} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-bg-dark pt-20 pb-14 sm:pt-24 sm:pb-16">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(59,130,246,0.12),transparent_35%),radial-gradient(circle_at_bottom_right,rgba(34,211,238,0.08),transparent_28%)]"></div>
    <div class="relative mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
      <p class="mx-auto max-w-full break-words text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-accent sm:text-sm sm:tracking-[0.35em]">{heroContent[toolKey].eyebrow}</p>
      <h1 class="mx-auto mt-5 max-w-4xl break-words text-2xl font-black leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-6xl text-balance">
        {heroContent[toolKey].title}
      </h1>
      <p class="mx-auto mt-5 max-w-3xl break-words text-base leading-7 text-slate-400 sm:mt-6 sm:text-xl sm:leading-8">
        {heroContent[toolKey].description}{targetHomeAnchor && <Fragment> Use our free <a href={targetHomeHref} class="text-brand-primary hover:text-blue-400 underline underline-offset-4 decoration-1 transition-colors">{targetHomeAnchor}</a> to draw and export full schematics.</Fragment>}
      </p>
      <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:mt-10 sm:flex-row sm:items-center">
        <a href={heroContent[toolKey].primaryCtaHref} class="w-full rounded-xl bg-brand-primary px-6 py-3.5 text-center text-sm font-semibold text-white transition hover:bg-blue-500 shadow-[0_0_24px_rgba(59,130,246,0.18)] sm:w-auto sm:px-8">
          {heroContent[toolKey].primaryCtaLabel}
        </a>
        <a href={heroContent[toolKey].secondaryCtaHref} class="w-full rounded-xl border border-white/10 px-6 py-3.5 text-center text-sm font-medium text-white transition hover:border-white/20 hover:bg-white/5 sm:w-auto sm:px-8">
          {heroContent[toolKey].secondaryCtaLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Online Tool Canvas -->
  <article aria-labelledby="tool-page-title" id="inline-tool">
    <InlineKeywordTool toolKey={toolKey} locale={locale} />
  </article>

  <!-- In-Depth Technical Architecture & Mathematical Foundation -->
  {richData && (
    <section id="guide" class="border-t border-white/5 bg-bg-panel py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-accent">Technical Architecture</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">{richData.inDepthGuide.title}</h2>
          <p class="mt-4 text-base leading-7 text-slate-400 sm:text-lg">{richData.inDepthGuide.subtitle}</p>
        </div>

        <div class="mt-10 grid gap-8 lg:grid-cols-3">
          <div class="lg:col-span-2 space-y-6 text-slate-300 leading-relaxed text-base">
            {richData.inDepthGuide.paragraphs.map((p) => (
              <p class="rounded-xl border border-white/5 bg-bg-surface/40 p-5 sm:p-6">{p}</p>
            ))}
          </div>

          <div class="space-y-4">
            <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Engineering Capabilities</h3>
            {richData.inDepthGuide.keyHighlights.map((highlight) => (
              <div class="rounded-2xl border border-white/10 bg-bg-surface/70 p-5 transition-all hover:border-brand-primary/30">
                <h4 class="font-bold text-white text-sm">{highlight.label}</h4>
                <p class="mt-2 text-xs text-slate-400 leading-relaxed">{highlight.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- De Morgan & Boolean Identities Reference Table (for Boolean Simplifier) -->
  {toolKey === 'boolean-expression-simplifier' && (
    <section class="border-t border-white/5 bg-bg-dark py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-accent">Algebraic Foundations</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">Fundamental Boolean Identities & Axioms</h2>
          <p class="mt-4 text-base leading-7 text-slate-400">Core algebraic laws automatically applied during canonical expansion and term minimization.</p>
        </div>

        <div class="mt-8 overflow-hidden rounded-2xl border border-white/10 bg-bg-surface/60">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-white/5 text-slate-300">
              <tr>
                <th class="px-5 py-3.5 font-semibold uppercase tracking-wider">Identity Name</th>
                <th class="px-5 py-3.5 font-semibold uppercase tracking-wider">Algebraic Formulation</th>
                <th class="px-5 py-3.5 font-semibold uppercase tracking-wider">Engineering Impact</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10 text-slate-300">
              <tr class="hover:bg-white/[0.02]"><td class="px-5 py-3.5 font-semibold text-white">De Morgan 1</td><td class="px-5 py-3.5 font-mono text-violet-400">(A &middot; B)&apos; = A&apos; + B&apos;</td><td class="px-5 py-3.5 text-slate-400">NAND is equivalent to an OR with complemented inputs; enables all-NAND synthesis.</td></tr>
              <tr class="hover:bg-white/[0.02]"><td class="px-5 py-3.5 font-semibold text-white">De Morgan 2</td><td class="px-5 py-3.5 font-mono text-violet-400">(A + B)&apos; = A&apos; &middot; B&apos;</td><td class="px-5 py-3.5 text-slate-400">NOR is equivalent to an AND with complemented inputs; enables all-NOR synthesis.</td></tr>
              <tr class="hover:bg-white/[0.02]"><td class="px-5 py-3.5 font-semibold text-white">Absorption Law</td><td class="px-5 py-3.5 font-mono text-sky-400">A + A &middot; B = A</td><td class="px-5 py-3.5 text-slate-400">Eliminates redundant dependent product terms to shrink gate counts.</td></tr>
              <tr class="hover:bg-white/[0.02]"><td class="px-5 py-3.5 font-semibold text-white">Consensus Theorem</td><td class="px-5 py-3.5 font-mono text-sky-400">A&middot;B + A&apos;&middot;C + B&middot;C = A&middot;B + A&apos;&middot;C</td><td class="px-5 py-3.5 text-slate-400">Identifies and removes redundant consensus terms, or adds them to eliminate static-1 hazards.</td></tr>
              <tr class="hover:bg-white/[0.02]"><td class="px-5 py-3.5 font-semibold text-white">Complementarity</td><td class="px-5 py-3.5 font-mono text-emerald-400">A + A&apos; = 1 &nbsp;|&nbsp; A &middot; A&apos; = 0</td><td class="px-5 py-3.5 text-slate-400">Collapses opposing literals to fixed voltage rails (VCC / GND).</td></tr>
              <tr class="hover:bg-white/[0.02]"><td class="px-5 py-3.5 font-semibold text-white">Idempotence</td><td class="px-5 py-3.5 font-mono text-emerald-400">A + A = A &nbsp;|&nbsp; A &middot; A = A</td><td class="px-5 py-3.5 text-slate-400">Permits duplicating shared minterms across multiple sub-cubes without changing logic.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <!-- Step-by-Step Engineering Workflow -->
  {richData && (
    <section class="border-t border-white/5 bg-bg-panel py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-accent">Workflow Guide</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">{richData.howToGuide.title}</h2>
          <p class="mt-4 text-base leading-7 text-slate-400 sm:text-lg">{richData.howToGuide.subtitle}</p>
        </div>

        <div class="mt-12 space-y-6">
          {richData.howToGuide.steps.map((item) => (
            <div class="rounded-2xl border border-white/10 bg-bg-surface/60 p-6 transition-all hover:border-brand-primary/30 sm:p-8">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-primary/10 border border-brand-primary/25 font-mono text-lg font-black text-brand-accent">
                  {item.stepNum}
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg font-bold text-white sm:text-xl">{item.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">{item.instructions}</p>
                  <div class="mt-4 rounded-xl border border-amber-400/20 bg-amber-400/5 px-4 py-3 text-xs leading-relaxed text-amber-300/90">
                    <strong class="font-bold uppercase tracking-wider text-amber-200">Engineering Pro-Tip: </strong>
                    {item.proTip}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Concrete Worked Example -->
  {richData && (
    <section class="border-t border-white/5 bg-bg-dark py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-accent">Practical Application</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">{richData.workedExample.title}</h2>
          <p class="mt-4 text-base leading-7 text-slate-400 sm:text-lg">{richData.workedExample.subtitle}</p>
        </div>

        <div class="mt-10 rounded-2xl border border-white/10 bg-bg-surface/60 p-6 sm:p-8">
          <div class="mb-6 border-b border-white/10 pb-6">
            <span class="inline-block rounded-md bg-brand-primary/10 border border-brand-primary/20 px-3 py-1 text-xs font-mono font-bold text-brand-accent">Circuit Blueprint</span>
            <h3 class="mt-2 text-xl font-bold text-white sm:text-2xl">{richData.workedExample.circuitName}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base">{richData.workedExample.problemStatement}</p>
          </div>

          <!-- Minterm / Specification Table -->
          <div class="my-8">
            <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400 mb-4">Minterm Coverage & Hardware Mapping</h4>
            <div class="overflow-x-auto rounded-xl border border-white/10 bg-bg-panel">
              <table class="w-full text-left text-xs sm:text-sm">
                <thead class="bg-white/5 text-slate-300">
                  <tr>
                    <th class="px-4 py-3 font-semibold uppercase tracking-wider">Ref / Term</th>
                    <th class="px-4 py-3 font-semibold uppercase tracking-wider">Logic Stage</th>
                    <th class="px-4 py-3 font-semibold uppercase tracking-wider">Binary / Algebraic Spec</th>
                    <th class="px-4 py-3 font-semibold uppercase tracking-wider">Functional Role</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/10 text-slate-300">
                  {richData.workedExample.bom.map((item) => (
                    <tr class="hover:bg-white/[0.02]">
                      <td class="px-4 py-3 font-mono font-bold text-brand-accent">{item.ref}</td>
                      <td class="px-4 py-3 font-semibold text-white">{item.name}</td>
                      <td class="px-4 py-3 font-mono text-slate-400">{item.spec}</td>
                      <td class="px-4 py-3 text-slate-300">{item.role}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Wiring / Derivation Stages -->
          <div class="my-8 space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400 mb-4">Step-by-Step Synthesis & Derivation Procedure</h4>
            {richData.workedExample.wiringSteps.map((ws) => (
              <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4 sm:p-5">
                <p class="text-xs font-mono font-bold text-brand-accent uppercase">{ws.step}</p>
                <h5 class="mt-1 text-sm font-bold text-white sm:text-base">{ws.title}</h5>
                <p class="mt-2 text-xs leading-relaxed text-slate-400 sm:text-sm">{ws.details}</p>
              </div>
            ))}
          </div>

          <!-- Verification Notes -->
          <div class="mt-8 rounded-xl border border-emerald-400/20 bg-emerald-400/5 p-5 text-xs sm:text-sm text-slate-300 leading-relaxed">
            <p class="font-bold text-emerald-400 uppercase tracking-wider mb-2">Electrical & Algebraic Verification:</p>
            {richData.workedExample.validationNotes}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- When to Use vs Alternatives Comparison -->
  {richData && (
    <section class="border-t border-white/5 bg-bg-panel py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-accent">Tool Comparison</p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-white sm:text-4xl">{richData.comparisons.title}</h2>
          <p class="mt-4 text-base leading-7 text-slate-400 sm:text-lg">{richData.comparisons.subtitle}</p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {richData.comparisons.competitors.map((comp) => (
            <div class="rounded-2xl border border-white/10 bg-bg-surface/70 p-6 flex flex-col justify-between">
              <div>
                <span class="inline-block rounded-md bg-white/5 border border-white/10 px-2.5 py-1 text-[10px] font-mono uppercase text-slate-400">{comp.type}</span>
                <h3 class="mt-3 text-lg font-bold text-white">{comp.name}</h3>
                <div class="mt-4 space-y-3 text-xs leading-relaxed">
                  <p class="text-slate-300"><strong class="text-emerald-400">Strengths: </strong>{comp.strengths}</p>
                  <p class="text-slate-400"><strong class="text-rose-400">Drawbacks: </strong>{comp.drawbacks}</p>
                </div>
              </div>
              <div class="mt-6 pt-4 border-t border-white/10 text-xs text-brand-accent font-medium leading-relaxed">
                <strong>When to Choose: </strong>{comp.whenToUse}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 rounded-xl border border-white/5 bg-white/[0.02] p-6 text-sm text-slate-300 leading-relaxed">
          {richData.comparisons.summary}
        </div>
      </div>
    </section>
  )}

  <RelatedToolsSection locale={locale} excludeKeys={[toolKey]} />

  <!-- FAQ Section -->
  <FAQ title={translateText('keyword.faq.title', 'Frequently Asked Questions')} items={faqItems} />
</BaseLayout>
